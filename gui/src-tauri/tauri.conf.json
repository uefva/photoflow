{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "photoflow",
  "version": "0.1.0",
  "identifier": "com.photoflow.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "photoflow · 照片库工作流",
        "width": 1020,
        "height": 800,
        "minWidth": 900,
        "minHeight": 680,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/icon.ico"]
  }
}
